<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Styles.Resources>
		<SolidColorBrush x:Key="MyRed">#972214</SolidColorBrush>
		<SolidColorBrush x:Key="MainRed">#E21A1A</SolidColorBrush>

		<!--bg-->
		<SolidColorBrush x:Key="Page">#F8F8F8</SolidColorBrush>
		<SolidColorBrush x:Key="Form">#FFFFFF</SolidColorBrush>
		<SolidColorBrush x:Key="Card">#FFFFFF</SolidColorBrush>

		<!--Font-->
		<SolidColorBrush x:Key="MainFont">#000000</SolidColorBrush>
		<SolidColorBrush x:Key="SecondFond">#8D8D8D</SolidColorBrush>

		<!--Button-->
		<SolidColorBrush x:Key="BtnDef">#0066A1</SolidColorBrush>
		<SolidColorBrush x:Key="BtnSecondary">#F4F4F4</SolidColorBrush>
		<SolidColorBrush x:Key="BtnHover">#00a0dc</SolidColorBrush>

		<!--TogleButton-->
		<SolidColorBrush x:Key="BtnStart">#228B22</SolidColorBrush>

		<!--Field-->
		<SolidColorBrush x:Key="FieldActive">#e9f9ff</SolidColorBrush>
		<SolidColorBrush x:Key="FieldHover">#f8fdff</SolidColorBrush>

		<SolidColorBrush x:Key="divider">#cecece</SolidColorBrush>

	</Styles.Resources>

    <Style Selector="AutoCompleteBox TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MainFont}" />
    </Style>

    <Style Selector="AutoCompleteBox">
        <Setter Property="Foreground" Value="{StaticResource MainFont}" />
        <Setter Property="TextElement.Background" Value="{StaticResource BtnSecondary}" />
    </Style>

    <Style Selector="AutoCompleteBox ListBoxItem">
        <Setter Property="Background" Value="{StaticResource Form}" />
    </Style>

    <Style Selector="AutoCompleteBox ContentPresenter:pointerover">
        <Setter Property="Background" Value="{StaticResource SecondFond}" />
    </Style>







	<Style Selector="DataGrid">
		<Setter Property="FontFamily" Value="{StaticResource RussianRailFont}"/>
	</Style>

	<!--Button-->
	<Style Selector="Button">
		<Setter Property="Background" Value="{StaticResource BtnDef}"/>
		<Setter Property="FontFamily" Value="{StaticResource RussianRailFont}"/>
		<Setter Property="Foreground" Value="{StaticResource Form}"/>
	</Style>

	<Style Selector="Button:disabled">
		<Setter Property="Background" Value="{StaticResource BtnSecondary}"/>
		<Setter Property="Foreground" Value="{StaticResource SecondFond}"/>
	</Style>

	<Style Selector="Button.Gray">
		<Setter Property="Background" Value="{StaticResource SecondFond}"/>
		<Setter Property="FontFamily" Value="{StaticResource RussianRailFont}"/>
	</Style>

	<Style Selector="Button.SecondBtn">
		<Setter Property="Background" Value="{StaticResource BtnSecondary}"/>
		<Setter Property="Foreground" Value="{StaticResource MainFont}" />
	</Style>

	<Style Selector="Button:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{StaticResource BtnHover}" />
		<Setter Property="Foreground" Value="{StaticResource MainFont}" />
	</Style>



	<!-- Стиль когда кнопка нажимается -->
	<Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{StaticResource BtnHover}" />
		<Setter Property="Foreground" Value="{StaticResource MainFont}" />
	</Style>

	<!--ToggleButton-->

	<Style Selector="ToggleButton">
		<Setter Property="Background" Value="{StaticResource MyRed}"/>
		<Setter Property="FontFamily" Value="{StaticResource RussianRailFont}"/>
		<Setter Property="Foreground" Value="{StaticResource Form}"/>
	</Style>

	<Style Selector="ToggleButton:unchecked /template/ ContentPresenter">
		<Setter Property="Background" Value="{StaticResource MyRed}"/>
	</Style>

	<Style Selector="ToggleButton:checked /template/ ContentPresenter">
		<Setter Property="Background" Value="{StaticResource BtnStart}"/>

	</Style>

	<Style Selector="ToggleButton:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{StaticResource BtnHover}" />
		<Setter Property="Foreground" Value="{StaticResource MainFont}" />
	</Style>

	<Style Selector="ToggleButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{StaticResource BtnHover}" />
		<Setter Property="Foreground" Value="{StaticResource MainFont}" />
	</Style>

	<!--Текст-->
	<Style Selector="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource MainFont}"/>
		<Setter Property="FontFamily" Value="{StaticResource RussianRailFont}"/>
	</Style>

	<Style Selector="TextBlock.SecondText">
		<Setter Property="Foreground" Value="{StaticResource SecondFond}"/>
		<Setter Property="FontFamily" Value="{StaticResource RussianRailFont}"/>
	</Style>

	<Style Selector="TextBlock:pointerover">
		<Setter Property="Foreground" Value="{StaticResource MainFont}"/>
	</Style>

	<!--Поля-->
	<Style Selector="TextBox">
		<Setter Property="Background" Value="{StaticResource BtnSecondary}"/>
		<Setter Property="Foreground" Value="{StaticResource MainFont}"/>
	</Style>

	<Style Selector="TextBox:empty">
		<Setter Property="Background" Value="{StaticResource BtnSecondary}"/>
	</Style>

	<Style Selector="TextBox:pointerover">
		<Setter Property="Foreground" Value="{StaticResource MainFont}"/>
		<Setter Property="BorderBrush" Value="#ff067977"/>
	</Style>

	<Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
		<Setter Property="Background" Value="{StaticResource FieldHover}"/>
		<Setter Property="BorderBrush" Value="#ff067977"/>
	</Style>

	<Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
		<Setter Property="Background" Value="{StaticResource FieldActive}"/>

	</Style>

	<Style Selector="TextBox:focus-within">
		<Setter Property="Foreground" Value="{StaticResource MainFont}" />
		<Setter Property="CaretBrush" Value="{StaticResource MainFont}" />
	</Style>



	<Style Selector="StackPanel.Header">
		<Setter Property="Background" Value="{StaticResource Page}"/>
	</Style>

	<Style Selector="Window">
		<Setter Property="Background" Value="{StaticResource divider}"/>
	</Style>

	<Style Selector="DataGridColumnHeader">
		<Setter Property="Background" Value="{StaticResource divider}"/>
	</Style>

	<!--CheckBox-->

	<Style Selector="CheckBox /template/ Border">
		<Setter Property="BorderBrush" Value="{StaticResource MainFont}"/>
	</Style>

	<Style Selector="CheckBox:unchecked">
		<Setter Property="BorderBrush" Value="{StaticResource MainFont}"/>
	</Style>

	<Style Selector="CheckBox:unchecked /template/ Border">
		<Setter Property="BorderBrush" Value="{StaticResource MainFont}"/>
	</Style>


	<!-- Окно логина -->
	<Style Selector="TextBox.LoginText">
		<Setter Property="Margin" Value="0 0 0 10"/>
		<Setter Property="BorderBrush" Value="LightGray"/>
		<Setter Property="BorderThickness" Value="2"/>
	</Style>

	<Style Selector="TextBlock.TitleLogin">
		<Setter Property="HorizontalAlignment" Value="Left"/>
		<Setter Property="Foreground" Value="{StaticResource BtnDef}"/>
		<Setter Property="FontFamily" Value="{StaticResource RussianRailFont}"/>
		<Setter Property="FontSize" Value="20"/>
	</Style>

	<Style Selector="Button.LoginBtn">
		<Setter Property="Background" Value="#E21A1A"/>
		<Setter Property="Foreground" Value="White"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="Padding" Value="10"/>
		<Setter Property="FontFamily" Value="{StaticResource RussianRailFont}"/>
	</Style>


	<Style Selector="Border.BorderMain">
		<Setter Property="Background" Value="{StaticResource BtnDef}"/>
	</Style>

	<Style Selector="DataValidationErrors">
		<Setter Property="Template">
			<ControlTemplate>
				<!-- Пустой шаблон — ничего не показываем -->
				<ContentPresenter Content="{TemplateBinding Content}" />
			</ControlTemplate>
		</Setter>
	</Style>

	<!-- Основное окно приложения -->


	<Style Selector="Window">
		<Setter Property="Background" Value="{StaticResource Page}"/>
	</Style>

	<!-- Выпадающий список -->
	
	<!-- Обычный элемент -->
	<Style Selector="AutoCompleteBox ListBoxItem">
		<Setter Property="Padding" Value="4 6"/>
		<Setter Property="CornerRadius" Value="4"/>
	</Style>

	<!-- Hover мышью -->
	<Style Selector="AutoCompleteBox ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="#3399FF"/>
	</Style>
	<Style Selector="AutoCompleteBox ListBoxItem:pointerover TextBlock">
		<Setter Property="Foreground" Value="White"/>
	</Style>

	<!-- ===== SELECTED (клавиши ↑↓ или клик) — фон + цвет текста ===== -->
	<Style Selector="AutoCompleteBox ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="#0078D4"/>
	</Style>
	<Style Selector="AutoCompleteBox ListBoxItem:selected TextBlock">
		<Setter Property="Foreground" Value="White"/>
	</Style>

	<!-- ===== SELECTED + HOVER — фон + цвет текста ===== -->
	<Style Selector="AutoCompleteBox ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="#005EA6"/>
	</Style>
	<Style Selector="AutoCompleteBox ListBoxItem:selected:pointerover TextBlock">
		<Setter Property="Foreground" Value="White"/>
	</Style>



</Styles>
