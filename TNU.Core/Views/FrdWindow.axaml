<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:repository1="clr-namespace:TNU.Core.Repository"
		xmlns:viewModels="clr-namespace:TNU.Core.ViewModels"

		xmlns:views="clr-namespace:TNU.Core.Views"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		Icon="/Assets/Ricon.png"
		x:Class="TNU.Core.Views.FrdWindow"
		x:DataType="viewModels:FrdPageViewModel"
		Title="SavedJobEntries">

	<Window.Styles>
		<StyleInclude Source="/Styles/MainStyles.axaml"></StyleInclude>
	</Window.Styles>

	<DockPanel Background="#F8F8F8">
		<Border DockPanel.Dock="Top" Padding="10">
			<Grid RowDefinitions="Auto, *, Auto" RowSpacing="10">
				<TextBlock Grid.Row="0"
						   Text="Сохранённые записи"
						   FontWeight="Bold"
						   Margin="5"
						   HorizontalAlignment="Center"/>

				<DataGrid Grid.Row="1"
						  ItemsSource="{x:Static repository1:FinishedEntriesRepository.FinishedEntries}"
						  AutoGenerateColumns="False"
						  GridLinesVisibility="All"
						  BorderThickness="2"
						  Padding="5"
						  BorderBrush="#8D8D8D"
						  Background="#FFFFFF"
						  Foreground="Black"
						  CornerRadius="5"
						  CanUserResizeColumns="True"
						  VerticalScrollBarVisibility="Auto"
						  HorizontalScrollBarVisibility="Auto">

					<DataGrid.Columns>
						<!--<DataGridTextColumn Header="№" Binding="{Binding Path=Id}"/>-->
						<DataGridTextColumn Header="Что наблюдается" Binding="{Binding JobName}"/>
						<DataGridTextColumn Header="Текущее время" Binding="{Binding EndTime}"/>
						<DataGridTextColumn Header="Продолжительность мин" Binding="{Binding JobSample}"/>
						<DataGridTextColumn Header="Индекс или код" Binding="{Binding JobCode}"/>
						<DataGridCheckBoxColumn Header="Уточнить время" Binding="{Binding IsTimedCorrectly}"/>
						<DataGridTemplateColumn Width="80">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>

				<StackPanel Grid.Row="2"
							Orientation="Horizontal"
							HorizontalAlignment="Center"
							Margin="0 0 0 10">

					<Button Content="Назад"
							Margin="0 0 10 0"
							Command="{Binding CloseFrdWindowCommand}"/>

					<Button Classes="Red"
							Content="Экспорт в формате Диаграммы Ганта"
							Margin="0 0 10 0"
							Command="{Binding ExportEntriesInGantaCommand}"/>

					<Button Classes="Red"
							Content="Экспорт"
							Margin="0 0 10 0"
							Command="{Binding ExportEntriesCommand}"/>

					<Button Classes="Red"
							Content="Перейти к списку ФРД"
							Margin="0 0 10 0"
							Command="{Binding GoToListFrdCommand}"/>
				</StackPanel>

			</Grid>
		</Border>
	</DockPanel>
</Window>
