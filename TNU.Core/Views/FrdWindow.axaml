<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:repository1="clr-namespace:TNU.Core.Repository"
        xmlns:viewModels="clr-namespace:TNU.Core.ViewModels"
        xmlns:views="clr-namespace:TNU.Core.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TNU.Core.Views.FrdWindow"
        x:DataType="viewModels:FrdWindowViewModel"
        Title="SavedJobEntries">
        
        <Window.Styles>
                <StyleInclude Source="/Styles/MainStyles.axaml"></StyleInclude>
        </Window.Styles>
    
        <DockPanel Background="DarkGray">
                <Border>
                        <ScrollViewer>
                                <StackPanel>
                                        <TextBlock Text="Сохранённые записи"
                                                   FontWeight="Bold"
                                                   Margin="5"
                                                   HorizontalAlignment="Center"/>
                                        
                                        <DataGrid ItemsSource="{x:Static repository1:FinishedEntriesRepository.FinishedEntries}"
                                                  AutoGenerateColumns="False"
                                                  GridLinesVisibility="All"
                                                  BorderThickness="1" BorderBrush="Gray">
                                                
                                                <DataGrid.Columns>
                                                        <DataGridTextColumn Header="№"  Binding="{Binding Path=Id}"/>
                                                        <DataGridTextColumn Header="Что наблюдается" Binding="{Binding JobName}" />
                                                        <DataGridTextColumn Header="Текущее время" Binding="{Binding EndTime}" />
                                                        <DataGridTextColumn Header="Продолжительность мин" Binding="{Binding JobSample}" />
                                                        <DataGridTextColumn Header="Индекс или код" Binding="{Binding JobCode}" />
                                                        <DataGridCheckBoxColumn Header="Уточнить время" Binding="{Binding IsTimedCorrectly}" />
                                                        <DataGridTemplateColumn Width="80">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                                <Button Content="✕" 
                                                                                        ToolTip.Tip="Удалить запись"
                                                                                        Classes="btn-delete"
                                                                                        HorizontalAlignment="Center"
                                                                                        Command="{Binding DeleteEntryCommand, 
                                                                                        RelativeSource={RelativeSource AncestorType={x:Type views:FrdWindow}}}"
                                                                                        CommandParameter="{Binding}" />
                                                                        </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                        </DataGrid>

                                        <StackPanel
                                                HorizontalAlignment="Center"
                                                Orientation="Horizontal">
                                                
                                                <Button Content="Назад"
                                                        Margin="0,10,10,10"
                                                        Command="{Binding CloseFrdWindowCommand}" />
                                                
                                                <Button Classes="Red"
                                                        Content="Экспорт в формате Диаграммы Ганта"
                                                        Margin="0,10,10,10"
                                                        Command="{Binding ExportEntriesInGantaCommand}" />


                                                <Button Classes="Red"
                                                        Content="Экспорт"
                                                        Margin="0,10,10,10"
                                                        Command="{Binding ExportEntriesCommand}" />
                                                
                                                <Button Classes="Red"
                                                        Content="Перейти к списку ФРД"
                                                        Margin="0,10,10,10"
                                                        Command="{Binding GoToListFrdCommand}" />
                                                
                                        </StackPanel >
                                </StackPanel>
                        </ScrollViewer>
                </Border>
        </DockPanel>
</Window>
