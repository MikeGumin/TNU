<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:repository1="clr-namespace:TNU.Core.Repository"
        xmlns:models="clr-namespace:TNU.Core.Models"
        xmlns:viewModels="clr-namespace:TNU.Core.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TNU.Core.Views.AllFrdWindow"
        Title="AllFrdWindow">
    <DockPanel x:Name="FrdDockPanel" x:DataType="viewModels:AllFrdWindowViewModel" Background="DarkGray">
                <Border>
                        <ScrollViewer>
                                <StackPanel >
                                        <TextBlock Text="Список ФРД на устройстве"
                                                   FontWeight="Bold"
                                                   Margin="5"
                                                   HorizontalAlignment="Center"/>

                                        <DataGrid ItemsSource="{x:Static repository1:FrdRepository.FinishedFrd}"
                                                  AutoGenerateColumns="False"
                                                  GridLinesVisibility="All"
                                                  BorderThickness="1" BorderBrush="Gray">

                                                <DataGrid.Columns>
                                                        <DataGridTextColumn Header="№"  
                                                                            Binding="{Binding Path=Id}"
                                                                            x:DataType="models:FrdModel" />
                                                        <DataGridTemplateColumn 
                                                                Header="Наименование файла"
                                                                Width="*">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate x:DataType="models:FrdModel">
                                                                                <Button 
                                                                                        HorizontalAlignment="Stretch"
                                                                                        Content="{Binding FileName}"
                                                                                        Command="{Binding ElementName=FrdDockPanel,  Path=DataContext.OpenFrdFileCommand}"
                                                                                        CommandParameter="{Binding}"
                                                                                        />
                                                                        </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn Header="Дата создания"  
                                                                            Binding="{Binding Path=CreatedAt}"
                                                                            x:DataType="models:FrdModel" />
                                                </DataGrid.Columns>
                                        </DataGrid>
                                        
                                        <StackPanel
                                                HorizontalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Button Content="Назад"
                                                        Margin="0,10,10,10"
                                                        Command="{Binding CloseAllFrdWindowCommand}" />
                                        </StackPanel>
                                </StackPanel>
                        </ScrollViewer>
                </Border>
            
        </DockPanel>
</Window>
